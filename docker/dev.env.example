# Ham Diploma Publisher – fejlesztői környezeti változók MINTA
#
# Másold `dev.env` néven (a dev.env NINCS verziókövetve).
#
# A src/config "HDP_*" kulcsai adják a defaultokat; az itt megadott
# (HDP_ prefix NÉLKÜLI) kulcsok felülírják őket, de CSAK ha a változó
# még nincs beállítva (src/definitions/00_variables.js) – ezért ne
# hagyj kulcsot üres értékkel.

# ── Adatbázis kapcsolatok ───────────────────────────────────────────
MODULE_MONGODB_WRAPPER_CONNECTION_STRING=mongodb://mongodb:27017
MODULE_REDIS_WRAPPER_CONNECTION_STRING=redis://redis:6379
MONGODB_DB_NAME=hdp

# ── Alkalmazás ──────────────────────────────────────────────────────
APP_DOMAIN=127.0.0.1:8000
# SUPERUSER_EMAIL: vesszővel elválasztva TÖBB cím is megadható
# (pl. SUPERUSER_EMAIL=admin@example.com,masik@example.com) — mindegyik
# regisztrációkor automatikusan superadmin (sa) lesz. Csak REGISZTRÁCIÓKOR
# fut le: ha valaki már korábban regisztrált, és utólag kerül be ide, a
# meglévő fiókja ettől nem válik automatikusan superadminná.
SUPERUSER_EMAIL=admin@example.com

# ── E-mail (a mailhog konténer fogja el; UI: http://127.0.0.1:8026) ──
# A MAIL_SMTP_OPTIONS-t a kód JSON.parse()-olja.
MAIL_SMTP=mailhog
MAIL_SMTP_OPTIONS={"port": 1025}
MAIL_FROM=noreply@example.com

# ── Vízjelezés / oklevél-renderelés (Puppeteer) ────────────────────
# A docker/Dockerfile.dev apt-getes rendszer-Chromiumára mutat, hogy a
# Puppeteer ne próbálja letölteni a saját (~300MB) példányát telepítéskor.
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# ── Tárhely (11. lépés) ─────────────────────────────────────────────
# STORAGE_DRIVER=local | s3 — helyben (`src/private/uploads/`) vagy
# S3-kompatibilis bucketben (AWS S3 / Backblaze B2 / Cloudflare R2 / MinIO)
# tárolja a feltöltött képeket/naplókat/PDF-eket (modules/storage-local.js
# ill. storage-s3.js — mindkettő ugyanazt a driver-független API-t
# valósítja meg). VIGYÁZAT: driver-váltás NEM migrálja át a már feltöltött
# fájlokat — élő adatbázison a váltás előtt a meglévő fájlokat kézzel át
# kell másolni az új tárhelyre, különben a régi rekordok (blankImage,
# issuedPdf, stb.) törött hivatkozásokra mutatnak.
STORAGE_DRIVER=local

# Helyi kipróbáláshoz: a docker-compose-dev.yml `minio`+`minio-init`
# service-ei egy MinIO szervert indítanak (`docker compose up minio
# minio-init`), és előre létrehozzák a lenti bucket-et — utána a fenti sort
# STORAGE_DRIVER=s3-re írva, és az alábbi 6 sort kikommentezve/kitöltve,
# helyben is tesztelhető az S3-driver valódi felhős fiók nélkül:
#S3_ENDPOINT=http://minio:9000
#S3_REGION=us-east-1
#S3_BUCKET=hdp-uploads
#S3_ACCESS_KEY=hdpminio
#S3_SECRET_KEY=hdpminiosecret
#S3_FORCE_PATH_STYLE=true

# Éles Backblaze B2 / Cloudflare R2 esetén ugyanezek a kulcsok, a
# szolgáltató saját "S3-compatible API" végpontjával/adataival (mindkettő
# path-style URL-t vár, tehát S3_FORCE_PATH_STYLE=true marad ott is):
#   Backblaze B2: S3_ENDPOINT=https://s3.<region>.backblazeb2.com
#   Cloudflare R2: S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# ── Fizetés (10. lépés) ─────────────────────────────────────────────
# Amíg ezek üresek, a Stripe/PayPal fizetési mód "nem elérhető" hibát ad
# (lásd modules/paypal-client.js, definitions/11_stripe.js) — a banki
# utalás viszont kulcsok NÉLKÜL is működik (manager manuális jóváhagyás).
#STRIPE_SECRET_KEY=
#STRIPE_WEBHOOK_SECRET=
#PAYPAL_CLIENT_ID=
#PAYPAL_CLIENT_SECRET=
#PAYPAL_WEBHOOK_ID=
#PAYPAL_ENV=sandbox
